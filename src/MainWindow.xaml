<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyIP" Width="376" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#D6D9DE"
        FontFamily="Segoe UI" FontSize="13" Foreground="#23272E"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <!-- Brushed aluminium faceplate -->
    <LinearGradientBrush x:Key="Plate" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#ECEEF1" Offset="0"/>
      <GradientStop Color="#D9DCE1" Offset="0.45"/>
      <GradientStop Color="#C6CAD0" Offset="1"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="Brushed" TileMode="Tile" Viewport="0,0,300,3" ViewportUnits="Absolute" Stretch="None">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#00000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,300,3"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#0C000000"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,300,1"/></GeometryDrawing.Geometry></GeometryDrawing>
          <GeometryDrawing Brush="#14FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,1,300,1"/></GeometryDrawing.Geometry></GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Raised metal key -->
    <LinearGradientBrush x:Key="Key" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FBFCFD" Offset="0"/>
      <GradientStop Color="#E3E6EA" Offset="0.5"/>
      <GradientStop Color="#C4C8CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#EDEFF2" Offset="0.5"/>
      <GradientStop Color="#D0D4DA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeyDown" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#B4B9C1" Offset="0"/>
      <GradientStop Color="#CDD1D7" Offset="0.3"/>
      <GradientStop Color="#DEE1E5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Blue" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#6FA8F5" Offset="0"/>
      <GradientStop Color="#3A7AE0" Offset="0.48"/>
      <GradientStop Color="#2563CC" Offset="0.52"/>
      <GradientStop Color="#1B4FA8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueHover" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#84B6F8" Offset="0"/>
      <GradientStop Color="#4B88E8" Offset="0.48"/>
      <GradientStop Color="#2F6FD8" Offset="0.52"/>
      <GradientStop Color="#2158B4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueDown" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#164289" Offset="0"/>
      <GradientStop Color="#2563CC" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="KeyShadow" Color="#000000" Direction="270" ShadowDepth="1.5" BlurRadius="3" Opacity="0.4"/>
    <DropShadowEffect x:Key="Engraved" Color="#FFFFFF" Direction="270" ShadowDepth="1" BlurRadius="0" Opacity="0.85"/>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4A505A"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="1,0,0,4"/>
      <Setter Property="Effect" Value="{StaticResource Engraved}"/>
    </Style>

    <Style x:Key="Error" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#B91C1C"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="1,3,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <!-- Recessed LCD display that doubles as the input -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="Foreground" Value="#9CFFC0"/>
      <Setter Property="CaretBrush" Value="#9CFFC0"/>
      <Setter Property="SelectionBrush" Value="#3FA36B"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="5" BorderThickness="0,0,0,1" BorderBrush="#F6F7F9">
              <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" BorderBrush="#5E646D">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0B120E" Offset="0"/>
                    <GradientStop Color="#16241C" Offset="0.3"/>
                    <GradientStop Color="#1B2C22" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <ScrollViewer x:Name="PART_ContentHost" Margin="7,0" VerticalAlignment="Center"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F7BE8"/>
              </Trigger>
              <Trigger Property="Tag" Value="error">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5383B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Metal" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Foreground" Value="#2B3038"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" CornerRadius="5" BorderThickness="1" BorderBrush="#7D838C"
                    Effect="{StaticResource KeyShadow}" Background="{StaticResource Key}">
              <Border x:Name="Shine" CornerRadius="4" BorderThickness="0,1,0,0" BorderBrush="#FFFFFF" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{StaticResource KeyHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{StaticResource KeyDown}"/>
                <Setter TargetName="Outer" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="Shine" Property="BorderBrush" Value="#9AA0A9"/>
                <Setter TargetName="Cp" Property="Margin" Value="0,2,0,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Outer" CornerRadius="5" BorderThickness="1" BorderBrush="#153F87"
                    Effect="{StaticResource KeyShadow}" Background="{StaticResource Blue}">
              <Border x:Name="Shine" CornerRadius="4" BorderThickness="0,1,0,0" BorderBrush="#A9CBFA">
                <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{StaticResource BlueHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Outer" Property="Background" Value="{StaticResource BlueDown}"/>
                <Setter TargetName="Outer" Property="Effect" Value="{x:Null}"/>
                <Setter TargetName="Shine" Property="BorderBrush" Value="#123670"/>
                <Setter TargetName="Cp" Property="Margin" Value="0,2,0,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TextToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#6B7079"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="1,2">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#2B3038"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" Padding="10,6" CornerRadius="4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#D5E3FA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource Key}" BorderBrush="#7D838C" BorderThickness="1"
                            CornerRadius="5" Effect="{StaticResource KeyShadow}">
                      <Border CornerRadius="4" BorderThickness="0,1,0,0" BorderBrush="#FFFFFF">
                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                              Data="M0,0 L4.5,5 L9,0 Z" Fill="#4A505A"/>
                      </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource KeyHover}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,5,30,5" VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="0,3,0,0" Background="#F4F5F7" BorderBrush="#7D838C" BorderThickness="1"
                        CornerRadius="5" Padding="4" MaxHeight="240"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Panel screw -->
    <ControlTemplate x:Key="Screw" TargetType="Control">
      <Grid Width="9" Height="9">
        <Ellipse Stroke="#8A9099" StrokeThickness="0.75">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#F4F5F7" Offset="0"/>
              <GradientStop Color="#A5ABB3" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Line X1="2" Y1="6.8" X2="7" Y2="2.2" Stroke="#6B7079" StrokeThickness="1"/>
      </Grid>
    </ControlTemplate>
  </Window.Resources>

  <Grid Background="{StaticResource Plate}">
    <Rectangle Fill="{StaticResource Brushed}" IsHitTestVisible="False"/>
    <Control Template="{StaticResource Screw}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" IsTabStop="False"/>
    <Control Template="{StaticResource Screw}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" IsTabStop="False"/>
    <Control Template="{StaticResource Screw}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5" IsTabStop="False"/>
    <Control Template="{StaticResource Screw}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" IsTabStop="False"/>

    <StackPanel Margin="20,18,20,18">

      <!-- Adapter -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="CbAdapter" AutomationProperties.Name="Network adapter">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="12" Height="12" Margin="0,0,9,0" VerticalAlignment="Center">
                  <Ellipse Fill="{Binding StatusColor}" Stroke="#3B4048" StrokeThickness="1"/>
                  <Ellipse Width="5" Height="4" Fill="#B0FFFFFF" VerticalAlignment="Top" Margin="0,1.5,0,0"/>
                </Grid>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#555B65" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource Metal}" Margin="8,0,0,0" Padding="0"
                Width="40" Height="Auto" ToolTip="Refresh" AutomationProperties.Name="Refresh">
          <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
        </Button>
      </Grid>

      <!-- Saved IPs, only shown once something is saved -->
      <Grid x:Name="PanelSaved" Margin="0,10,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="CbProfile" DisplayMemberPath="Name" AutomationProperties.Name="Saved IPs"/>
        <TextBlock x:Name="TxtProfileHint" Text="Saved IPs" IsHitTestVisible="False" Foreground="#555B65"
                   VerticalAlignment="Center" Margin="11,0,0,0"/>
        <Button x:Name="BtnDeleteProfile" Grid.Column="1" Style="{StaticResource Metal}" Margin="8,0,0,0" Padding="0"
                Width="40" Height="Auto" ToolTip="Delete this saved IP" AutomationProperties.Name="Delete saved IP">
          <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
        </Button>
      </Grid>

      <!-- IP and mask: show the current values and accept new ones -->
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource Label}" Text="IP address"/>
          <TextBox x:Name="TbIp" AutomationProperties.Name="IP address"/>
          <TextBlock x:Name="ErrIp" Style="{StaticResource Error}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Style="{StaticResource Label}" Text="Subnet mask"/>
          <TextBox x:Name="TbMask" AutomationProperties.Name="Subnet mask"/>
          <TextBlock x:Name="ErrMask" Style="{StaticResource Error}"/>
        </StackPanel>
      </Grid>

      <ToggleButton x:Name="BtnMore" Style="{StaticResource TextToggle}" Margin="0,8,0,0">
        <TextBlock x:Name="TxtMore" Text="More options &gt;&gt;"/>
      </ToggleButton>

      <StackPanel x:Name="PanelMore" Visibility="Collapsed" Margin="0,6,0,0">
        <TextBlock Style="{StaticResource Label}" Text="Gateway"/>
        <TextBox x:Name="TbGateway" AutomationProperties.Name="Gateway"/>
        <TextBlock x:Name="ErrGateway" Style="{StaticResource Error}"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource Label}" Text="DNS"/>
            <TextBox x:Name="TbDns1" AutomationProperties.Name="Preferred DNS"/>
            <TextBlock x:Name="ErrDns1" Style="{StaticResource Error}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Style="{StaticResource Label}" Text="Alternate DNS"/>
            <TextBox x:Name="TbDns2" AutomationProperties.Name="Alternate DNS"/>
            <TextBlock x:Name="ErrDns2" Style="{StaticResource Error}"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- Name for a new saved IP -->
      <StackPanel x:Name="PanelName" Visibility="Collapsed" Margin="0,10,0,0">
        <TextBlock Style="{StaticResource Label}" Text="Name"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TbProfileName" MaxLength="40" AutomationProperties.Name="Name"/>
          <Button x:Name="BtnNameOk" Grid.Column="1" Style="{StaticResource Metal}" Height="34" Margin="8,0,0,0" Content="OK"/>
          <Button x:Name="BtnNameCancel" Grid.Column="2" Style="{StaticResource Metal}" Height="34" Margin="6,0,0,0" Content="Cancel"/>
        </Grid>
        <TextBlock x:Name="ErrName" Style="{StaticResource Error}"/>
      </StackPanel>

      <!-- Actions -->
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="BtnDhcp" Style="{StaticResource Metal}" Padding="10,0" ToolTip="Get the IP automatically from the router"
                AutomationProperties.Name="DHCP">
          <StackPanel Orientation="Horizontal">
            <Grid Width="10" Height="10" Margin="0,0,7,0" VerticalAlignment="Center">
              <Ellipse x:Name="DhcpLed" Fill="#6B7079" Stroke="#3B4048" StrokeThickness="1"/>
              <Ellipse Width="4" Height="3" Fill="#A0FFFFFF" VerticalAlignment="Top" Margin="0,1,0,0"/>
            </Grid>
            <TextBlock Text="DHCP"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnSave" Grid.Column="2" Style="{StaticResource Metal}" Margin="0,0,8,0" ToolTip="Save these values to reuse later"
                AutomationProperties.Name="Save">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="Save"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnApply" Grid.Column="3" Style="{StaticResource Primary}" IsDefault="True" AutomationProperties.Name="Apply">
          <TextBlock x:Name="TxtApply" Text="Apply"/>
        </Button>
      </Grid>

      <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="3" Margin="0,8,0,0" BorderThickness="0"
                   Background="Transparent" Foreground="#2563CC" Visibility="Collapsed"/>

      <Border x:Name="Banner" CornerRadius="5" Padding="10,7" Margin="0,10,0,0" BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="12.5"/>
      </Border>
    </StackPanel>
  </Grid>
</Window>
